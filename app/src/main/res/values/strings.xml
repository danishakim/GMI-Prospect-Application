    <!-- About -->
    <string name="title_about">About Us</string>
    <string name="about_heading">German-Malaysian Institute</string>
    <string name="about_body">The German-Malaysian Institute (GMI) is a leading technical and vocational education and training (TVET) institution in Kajang, Selangor. It was established in 1991 as a joint project between the Governments of Malaysia and the Federal Republic of Germany, and is owned by Majlis Amanah Rakyat (MARA) and Yayasan Pelajaran MARA (YPM).\n\nGMI delivers German-standard, industry-driven education with a strong emphasis on practical training, giving graduates high employability in the manufacturing, engineering and technology sectors.</string>
    <string name="about_vision_title">Vision</string>
    <string name="about_vision">To be a premier institution in technical education and training with a German approach.</string>
    <string name="about_mission_title">Mission</string>
    <string name="about_mission">To produce competent, innovative and industry-ready graduates through German-based technical education, applied research and strong industry partnerships.</string>
    <string name="about_why_title">Why choose GMI?</string>
    <string name="about_why_1" formatted="false">German dual-system approach: about 70% practical, 30% theory</string>    <string name="about_why_2">Strong industry links with German and multinational companies</string>
    <string name="about_why_3">Pathways to degrees in Germany (GAPP) and UTP (GUFP)</string>
    <string name="about_why_4">High graduate employability</string>
